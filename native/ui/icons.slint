// Stroke icons on a 24-unit grid (same set as the web UI).

export enum IconKind { equity, target, stack, settings, bolt, stop, dice, copy, trash, x, plus, minus, bars, sparkle, filter, chevron, arrow, folder, check, alert, refresh }

export component Icon inherits Path {
    in property <IconKind> kind;
    in property <color> color: #a5b2ab;
    in property <length> size: 18px;
    width: size;
    height: size;
    viewbox-width: 24;
    viewbox-height: 24;
    stroke: color;
    stroke-width: 1.8px;
    stroke-line-cap: round;
    fill: transparent;
    commands: kind == IconKind.equity ? "M 12 3 V 12 L 19.8 16.5 M 3 12 A 9 9 0 1 0 21 12 A 9 9 0 1 0 3 12"
        : kind == IconKind.target ? "M 3 12 A 9 9 0 1 0 21 12 A 9 9 0 1 0 3 12 M 7 12 A 5 5 0 1 0 17 12 A 5 5 0 1 0 7 12 M 11 12 A 1 1 0 1 0 13 12 A 1 1 0 1 0 11 12"
        : kind == IconKind.stack ? "M 5 6 A 7 2.6 0 1 0 19 6 A 7 2.6 0 1 0 5 6 M 5 6 V 10 C 5 11.4 8.1 12.6 12 12.6 C 15.9 12.6 19 11.4 19 10 V 6 M 5 10 V 14 C 5 15.4 8.1 16.6 12 16.6 C 15.9 16.6 19 15.4 19 14 V 10 M 5 14 V 18 C 5 19.4 8.1 20.6 12 20.6 C 15.9 20.6 19 19.4 19 18 V 14"
        : kind == IconKind.settings ? "M 9 12 A 3 3 0 1 0 15 12 A 3 3 0 1 0 9 12 M 5.5 12 A 6.5 6.5 0 1 0 18.5 12 A 6.5 6.5 0 1 0 5.5 12 M 12 2.5 V 5.5 M 12 18.5 V 21.5 M 2.5 12 H 5.5 M 18.5 12 H 21.5 M 5.3 5.3 L 7.4 7.4 M 16.6 16.6 L 18.7 18.7 M 5.3 18.7 L 7.4 16.6 M 16.6 7.4 L 18.7 5.3"
        : kind == IconKind.bolt ? "M 13 2 L 4 14 H 11 L 10 22 L 19 10 H 12 L 13 2 Z"
        : kind == IconKind.stop ? "M 8.5 6 H 15.5 A 2.5 2.5 0 0 1 18 8.5 V 15.5 A 2.5 2.5 0 0 1 15.5 18 H 8.5 A 2.5 2.5 0 0 1 6 15.5 V 8.5 A 2.5 2.5 0 0 1 8.5 6 Z"
        : kind == IconKind.dice ? "M 7.5 3.5 H 16.5 A 4 4 0 0 1 20.5 7.5 V 16.5 A 4 4 0 0 1 16.5 20.5 H 7.5 A 4 4 0 0 1 3.5 16.5 V 7.5 A 4 4 0 0 1 7.5 3.5 Z M 8.5 8.5 L 8.6 8.5 M 15.5 15.5 L 15.6 15.5 M 15.5 8.5 L 15.6 8.5 M 8.5 15.5 L 8.6 15.5 M 12 12 L 12.1 12"
        : kind == IconKind.copy ? "M 11.5 9 H 17.5 A 2.5 2.5 0 0 1 20 11.5 V 17.5 A 2.5 2.5 0 0 1 17.5 20 H 11.5 A 2.5 2.5 0 0 1 9 17.5 V 11.5 A 2.5 2.5 0 0 1 11.5 9 Z M 5 15 V 6 A 2 2 0 0 1 7 4 H 15"
        : kind == IconKind.trash ? "M 4 7 H 20 M 10 11 V 17 M 14 11 V 17 M 6 7 L 7 19 A 2 2 0 0 0 9 21 H 15 A 2 2 0 0 0 17 19 L 18 7 M 9 7 V 4 H 15 V 7"
        : kind == IconKind.x ? "M 6 6 L 18 18 M 18 6 L 6 18"
        : kind == IconKind.plus ? "M 12 5 V 19 M 5 12 H 19"
        : kind == IconKind.minus ? "M 5 12 H 19"
        : kind == IconKind.bars ? "M 4 20 H 20 M 5 11 H 8 V 17 H 5 Z M 10.5 6 H 13.5 V 17 H 10.5 Z M 16 9 H 19 V 17 H 16 Z"
        : kind == IconKind.sparkle ? "M 12 3 L 13.8 8.2 L 19 10 L 13.8 11.8 L 12 17 L 10.2 11.8 L 5 10 L 10.2 8.2 Z M 19 16 L 19.8 18.2 L 22 19 L 19.8 19.8 L 19 22 L 18.2 19.8 L 16 19 L 18.2 18.2 Z"
        : kind == IconKind.filter ? "M 4 5 H 20 L 14 12.5 V 19 L 10 21 V 12.5 Z"
        : kind == IconKind.chevron ? "M 6 9 L 12 15 L 18 9"
        : kind == IconKind.arrow ? "M 5 12 H 19 M 13 6 L 19 12 L 13 18"
        : kind == IconKind.folder ? "M 3 7 A 2 2 0 0 1 5 5 H 9 L 11 7 H 19 A 2 2 0 0 1 21 9 V 17 A 2 2 0 0 1 19 19 H 5 A 2 2 0 0 1 3 17 Z"
        : kind == IconKind.check ? "M 5 12.5 L 9.5 17 L 19 7.5"
        : kind == IconKind.alert ? "M 12 9 V 13 M 12 17 L 12 17.01 M 10.3 3.9 L 2.6 17.5 A 2 2 0 0 0 4.3 20.5 H 19.7 A 2 2 0 0 0 21.4 17.5 L 13.7 3.9 A 2 2 0 0 0 10.3 3.9 Z"
        : "M 20 11 A 8 8 0 0 0 5.1 8 M 4 4 V 8 H 8 M 4 13 A 8 8 0 0 0 18.9 16 M 20 20 V 16 H 16";
}
