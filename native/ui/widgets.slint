// General widgets, styled like the web UI.

import { Theme, Motion, Ease, HtSeg, DonutSeg } from "data.slint";
import { Icon, IconKind } from "icons.slint";

export component Panel inherits Rectangle {
    in property <length> pad: 16px;
    vertical-stretch: 0;
    border-radius: 16px;
    background: @linear-gradient(180deg, Theme.surface2 0%, Theme.surface 100%);
    border-width: 1px;
    border-color: Theme.line;
    drop-shadow-blur: 30px;
    drop-shadow-offset-y: 14px;
    drop-shadow-color: #00000070;
    VerticalLayout {
        padding: root.pad;
        spacing: 12px;
        @children
    }
}

export component SectionTitle inherits Text {
    color: Theme.text2;
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: 1px;
    vertical-alignment: center;
}

export component Dim inherits Text {
    color: Theme.text3;
    font-size: 12px;
    vertical-alignment: center;
}

export component Kbd inherits Rectangle {
    in property <string> text;
    in property <bool> muted;
    horizontal-stretch: 0;
    height: 19px;
    min-width: 19px;
    border-radius: 5px;
    border-width: 1px;
    border-color: muted ? #00000030 : Theme.line2;
    background: muted ? #00000018 : #ffffff0a;
    HorizontalLayout {
        padding-left: 5px;
        padding-right: 5px;
        Text {
            text: root.text;
            color: root.muted ? #03150db0 : Theme.text2;
            font-size: 10.5px;
            font-weight: 600;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }
}

export component Spinner inherits Rectangle {
    in property <length> size: 14px;
    in property <color> ink: Theme.text2;
    width: size;
    height: size;
    property <float> t;
    Timer { interval: 16ms; running: true; triggered => { root.t = mod(root.t + 0.022, 1); } }
    Path {
        width: root.size;
        height: root.size;
        viewbox-width: 20;
        viewbox-height: 20;
        stroke: root.ink;
        stroke-width: 2px;
        stroke-line-cap: round;
        fill: transparent;
        // a 270 degree arc, rotated each frame
        property <angle> a0: root.t * 360deg;
        property <angle> a1: a0 + 270deg;
        commands: "M \{10 + 8 * cos(a0)} \{10 + 8 * sin(a0)} A 8 8 0 1 1 \{10 + 8 * cos(a1)} \{10 + 8 * sin(a1)}";
    }
}

// variant: 0 ghost, 1 soft, 2 primary
export component Btn inherits Rectangle {
    in property <string> text;
    in property <IconKind> icon;
    in property <bool> has-icon;
    in property <int> variant: 0;
    in property <bool> enabled: true;
    in property <bool> busy;
    in property <string> hint;
    in property <length> font-size: 12.5px;
    in property <length> pad-x: 11px;
    callback clicked();
    height: 30px;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-radius: 9px;
    opacity: enabled ? 1 : 0.38;
    background: variant == 2 ? (ta.has-hover && enabled ? @linear-gradient(135deg, #5cecb8 0%, #14c48b 100%) : @linear-gradient(135deg, #46e3aa 0%, Theme.accent2 100%))
        : variant == 1 ? (ta.has-hover && enabled ? #ffffff1a : #ffffff0f)
        : (ta.has-hover && enabled ? #ffffff0e : transparent);
    border-width: variant == 1 ? 1px : 0px;
    border-color: Theme.line2;
    drop-shadow-blur: variant == 2 ? 18px : 0px;
    drop-shadow-offset-y: variant == 2 ? 6px : 0px;
    drop-shadow-color: variant == 2 ? #10b98166 : transparent;
    transform-scale: ta.pressed && enabled ? 0.96 : 1;
    animate background, transform-scale { duration: Motion.fast; }
    property <color> fg: variant == 2 ? Theme.accent-ink : ta.has-hover && enabled ? Theme.text : (variant == 1 ? Theme.text : Theme.text2);
    HorizontalLayout {
        padding-left: root.pad-x;
        padding-right: root.pad-x;
        spacing: 6px;
        alignment: center;
        if root.busy: Spinner { size: 12px; y: (parent.height - self.height) / 2; }
        if root.has-icon && !root.busy: Icon { kind: root.icon; color: root.fg; size: 15px; y: (parent.height - self.height) / 2; }
        if root.text != "": Text {
            text: root.text;
            color: root.fg;
            font-size: root.font-size;
            font-weight: 600;
            vertical-alignment: center;
        }
        if root.hint != "": Kbd { text: root.hint; y: (parent.height - self.height) / 2; muted: root.variant == 2; }
    }
    ta := TouchArea {
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { if (root.enabled) { root.clicked(); } }
    }
}

export component IconBtn inherits Rectangle {
    in property <IconKind> icon;
    in property <bool> enabled: true;
    in property <bool> danger;
    in property <length> size: 30px;
    in property <length> icon-size: 16px;
    callback clicked();
    width: size;
    height: size;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-radius: 9px;
    opacity: enabled ? 1 : 0.3;
    background: ta.has-hover && enabled ? (danger ? #f871711a : #ffffff10) : transparent;
    transform-scale: ta.pressed && enabled ? 0.88 : 1;
    animate background, transform-scale { duration: Motion.fast; }
    Icon {
        kind: root.icon;
        size: root.icon-size;
        color: ta.has-hover && root.enabled ? (root.danger ? Theme.danger : Theme.text) : Theme.text3;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
    ta := TouchArea {
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { if (root.enabled) { root.clicked(); } }
    }
}

// equal-width segmented control with a pill that glides to the selection
export component Segmented inherits Rectangle {
    in property <[string]> labels;
    in property <[string]> subs;
    in property <int> current;
    in property <length> font-size: 12.5px;
    callback selected(int);
    property <length> pad: 3px;
    property <length> seg-w: (self.width - 2 * pad) / max(1, labels.length);
    height: subs.length > 0 ? 44px : 30px;
    border-radius: 11px;
    background: #00000047;
    border-width: 1px;
    border-color: Theme.line;
    Rectangle {
        x: root.pad + root.current * root.seg-w;
        y: root.pad;
        width: root.seg-w;
        height: root.height - 2 * root.pad;
        border-radius: 8px;
        background: @linear-gradient(180deg, #24322c 0%, #1c2823 100%);
        border-width: 1px;
        border-color: Theme.line2;
        drop-shadow-blur: 10px;
        drop-shadow-offset-y: 3px;
        drop-shadow-color: #00000090;
        animate x { duration: Motion.med; easing: Ease.spring; }
    }
    for l[i] in labels: Rectangle {
        x: root.pad + i * root.seg-w;
        y: root.pad;
        width: root.seg-w;
        height: root.height - 2 * root.pad;
        VerticalLayout {
            alignment: center;
            spacing: 1px;
            Text {
                text: l;
                horizontal-alignment: center;
                font-size: root.font-size;
                font-weight: 600;
                color: i == root.current ? Theme.text : seg-ta.has-hover ? Theme.text2 : Theme.text3;
                animate color { duration: Motion.fast; }
            }
            if root.subs.length > i: Text {
                text: root.subs[i];
                horizontal-alignment: center;
                font-size: 10.5px;
                color: i == root.current ? Theme.accent : Theme.text3;
            }
        }
        seg-ta := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.selected(i); }
        }
    }
}

export component Switch inherits Rectangle {
    in property <bool> checked;
    callback toggled(bool);
    width: 38px;
    height: 22px;
    border-radius: 11px;
    background: checked ? Theme.accent2 : #ffffff14;
    border-width: checked ? 0px : 1px;
    border-color: Theme.line2;
    animate background { duration: Motion.med; }
    Rectangle {
        x: root.checked ? root.width - self.width - 3px : 3px;
        y: 3px;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: white;
        drop-shadow-blur: 4px;
        drop-shadow-color: #00000080;
        animate x { duration: Motion.med; easing: Ease.spring; }
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggled(!root.checked); }
    }
}

export component SwitchRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> hint;
    in property <bool> checked;
    callback toggled(bool);
    spacing: 14px;
    VerticalLayout {
        alignment: center;
        Text { text: root.label; color: Theme.text; font-size: 13px; font-weight: 600; }
        if root.hint != "": Text { text: root.hint; color: Theme.text3; font-size: 11.5px; wrap: word-wrap; }
    }
    Switch {
        checked: root.checked;
        toggled(v) => { root.toggled(v); }
        y: (parent.height - self.height) / 2;
    }
}

// whole-number input 0..100 that commits on every valid keystroke
export component NumInput inherits Rectangle {
    in property <int> value;
    in property <int> minimum: 0;
    in property <int> maximum: 100;
    callback edited(int);
    width: 52px;
    height: 30px;
    border-radius: 8px;
    border-width: 1px;
    border-color: ti.has-focus ? Theme.accent : Theme.line2;
    background: #00000040;
    animate border-color { duration: Motion.fast; }
    changed value => { if (!ti.has-focus) { ti.text = root.value; } }
    ti := TextInput {
        text: root.value;
        input-type: number;
        color: Theme.text;
        font-size: 13px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
        selection-background-color: #34d39955;
        edited => {
            if (self.text.is-float()) {
                root.edited(clamp(round(self.text.to-float()), root.minimum, root.maximum));
            }
        }
        changed has-focus => { if (!self.has-focus) { self.text = root.value; } }
    }
}

// dual-handle percentile slider (0 weakest .. 100 strongest)
export component RangeSlider inherits Rectangle {
    in property <int> lo;
    in property <int> hi;
    in property <color> pc;
    in property <bool> compact;
    callback range-changed(int, int);
    property <int> drag: 0;     // 1 low handle, 2 high handle, 3 the band
    property <int> start-lo;
    property <int> start-hi;
    property <length> start-x;
    property <length> knob: compact ? 13px : 18px;
    height: compact ? 22px : 30px;
    min-width: 120px;

    pure function val(x: length) -> int {
        return clamp(round(x / self.width * 100), 0, 100);
    }

    Rectangle {  // track
        y: (root.height - self.height) / 2;
        height: root.compact ? 4px : 6px;
        border-radius: self.height / 2;
        background: @linear-gradient(90deg, #ffffff0a 0%, #ffffff24 100%);
    }
    Rectangle {  // band
        x: root.width * root.lo / 100;
        width: root.width * (root.hi - root.lo) / 100;
        y: (root.height - self.height) / 2;
        height: root.compact ? 4px : 6px;
        border-radius: self.height / 2;
        background: @linear-gradient(90deg, root.pc.transparentize(60%) 0%, root.pc 100%);
        drop-shadow-blur: 10px;
        drop-shadow-color: root.pc.transparentize(55%);
        animate x, width { duration: root.drag == 0 ? Motion.med : 0ms; easing: Ease.smooth; }
    }
    for k in 2: kn := Rectangle {
        property <int> v: k == 0 ? root.lo : root.hi;
        property <bool> hot: root.drag == k + 1 || knob-ta.has-hover;
        x: root.width * v / 100 - self.width / 2;
        y: (root.height - self.height) / 2;
        width: hot ? root.knob + 2px : root.knob;
        height: self.width;
        border-radius: self.width / 2;
        background: white;
        border-width: root.compact ? 2px : 3px;
        border-color: root.pc;
        drop-shadow-blur: hot ? 14px : 6px;
        drop-shadow-color: hot ? root.pc.transparentize(30%) : #00000099;
        animate x { duration: root.drag == 0 ? Motion.med : 0ms; easing: Ease.smooth; }
        animate width, drop-shadow-blur { duration: Motion.fast; }
        knob-ta := TouchArea { }
        if !root.compact && kn.hot: Rectangle {
            y: -26px;
            x: (parent.width - self.width) / 2;
            width: 30px;
            height: 20px;
            border-radius: 6px;
            background: Theme.bg2;
            border-width: 1px;
            border-color: Theme.line2;
            Text { text: kn.v; color: Theme.text; font-size: 11px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
        }
    }
    TouchArea {
        mouse-cursor: root.drag == 3 ? grabbing : pointer;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                root.start-x = self.mouse-x;
                root.start-lo = root.lo;
                root.start-hi = root.hi;
                if (abs(self.mouse-x - root.width * root.lo / 100) <= root.knob) {
                    root.drag = 1;
                } else if (abs(self.mouse-x - root.width * root.hi / 100) <= root.knob) {
                    root.drag = 2;
                } else if (root.val(self.mouse-x) > root.lo && root.val(self.mouse-x) < root.hi && root.hi - root.lo < 100) {
                    root.drag = 3;
                } else {
                    // jump the nearer handle to the click
                    root.drag = abs(root.val(self.mouse-x) - root.lo) <= abs(root.val(self.mouse-x) - root.hi) ? 1 : 2;
                    self.moved();
                }
            } else if (e.kind == PointerEventKind.up) {
                root.drag = 0;
            }
        }
        moved => {
            if (root.drag == 1) {
                root.range-changed(min(root.val(self.mouse-x), root.hi - 1), root.hi);
            } else if (root.drag == 2) {
                root.range-changed(root.lo, max(root.val(self.mouse-x), root.lo + 1));
            } else if (root.drag == 3) {
                let w = root.start-hi - root.start-lo;
                let nlo = clamp(round(root.start-lo + (self.mouse-x - root.start-x) / root.width * 100), 0, 100 - w);
                root.range-changed(nlo, nlo + w);
            }
        }
    }
}

export component ProgressRing inherits Rectangle {
    in property <float> value;
    in property <length> size: 44px;
    in property <length> stroke: 4px;
    width: size;
    height: size;
    property <float> shown: value;
    animate shown { duration: Motion.med; easing: Ease.smooth; }
    property <float> v: clamp(shown, 0.001, 0.9999);
    Path {
        width: root.size; height: root.size;
        viewbox-width: 100; viewbox-height: 100;
        stroke: #ffffff1a; stroke-width: root.stroke; fill: transparent;
        commands: "M 50 6 A 44 44 0 1 1 49.99 6";
    }
    Path {
        width: root.size; height: root.size;
        viewbox-width: 100; viewbox-height: 100;
        stroke: Theme.accent; stroke-width: root.stroke; fill: transparent;
        stroke-line-cap: round;
        property <angle> a: root.v * 360deg - 90deg;
        commands: "M 50 6 A 44 44 0 \{root.v > 0.5 ? 1 : 0} 1 \{50 + 44 * cos(a)} \{50 + 44 * sin(a)}";
    }
}

// one ring segment of the pot-share donut; springs to new arcs
component DonutArc inherits Path {
    in property <float> start;
    in property <float> len;
    in property <length> size;
    in property <bool> hot;
    property <float> s: start;
    property <float> l: len;
    animate s, l { duration: Motion.slow; easing: Ease.spring; }
    property <float> gap: 0.006;
    property <float> ll: max(0, min(l - gap, 0.9999));
    property <angle> a0: s * 360deg - 90deg;
    property <angle> a1: (s + ll) * 360deg - 90deg;
    width: size;
    height: size;
    viewbox-width: 100;
    viewbox-height: 100;
    fill: transparent;
    stroke-width: hot ? 13px : 10px;
    animate stroke-width { duration: Motion.fast; }
    commands: ll <= 0.0005 ? "" : "M \{50 + 42 * cos(a0)} \{50 + 42 * sin(a0)} A 42 42 0 \{ll > 0.5 ? 1 : 0} 1 \{50 + 42 * cos(a1)} \{50 + 42 * sin(a1)}";
}

export component Donut inherits Rectangle {
    in property <[DonutSeg]> segs;
    in property <length> size: 168px;
    in property <string> label;
    in property <float> value;
    in property <color> label-color;
    in property <bool> stale;
    width: size;
    height: size;
    opacity: stale ? 0.45 : 1;
    animate opacity { duration: Motion.fade; }
    Path {
        width: root.size; height: root.size;
        viewbox-width: 100; viewbox-height: 100;
        stroke: #ffffff0d; stroke-width: 10px; fill: transparent;
        commands: "M 50 8 A 42 42 0 1 1 49.99 8";
    }
    for s in segs: DonutArc {
        size: root.size;
        start: s.start;
        len: s.len;
        stroke: s.color;
    }
    property <float> shown: value;
    animate shown { duration: Motion.slow; easing: Ease.smooth; }
    VerticalLayout {
        alignment: center;
        Text { text: root.label; color: root.label-color; font-size: 11px; font-weight: 700; letter-spacing: 1px; horizontal-alignment: center; }
        Text { text: root.shown.to-fixed(1) + "%"; color: Theme.text; font-size: 24px; font-weight: 700; horizontal-alignment: center; }
    }
}

// stacked made-hand bar; segments spring to new widths
export component HtBar inherits Rectangle {
    in property <[HtSeg]> segs;
    in property <bool> labels;
    clip: true;
    border-radius: labels ? 7px : 3px;
    background: #ffffff0a;
    for s in segs: Rectangle {
        x: root.width * s.x / 100;
        width: max(0px, root.width * s.w / 100 - (root.labels ? 2px : 1px));
        height: root.height;
        background: s.color;
        animate x, width { duration: Motion.slow; easing: Ease.smooth; }
        if root.labels && s.w >= 8: Text {
            text: round(s.w) + "%";
            color: #000000b0;
            font-size: 11px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}
