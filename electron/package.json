{
  "name": "plo5-equity-lab",
  "productName": "PLO5 Equity Lab",
  "version": "1.0.0",
  "description": "Desktop app for the PLO5 equity engine: equity calculator, range analyzer and trainers for 5-card Pot Limit Omaha.",
  "license": "MIT",
  "private": true,
  "main": "main/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "start": "vite build && electron .",
    "test": "node --test \"test/*.test.mjs\"",
    "dist": "vite build && electron-builder",
    "dist:dir": "vite build && electron-builder --dir"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.9.0",
    "electron-builder": "26.17.0",
    "motion": "14.4.0",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "vite": "8.3.4"
  },
  "build": {
    "appId": "com.plo5.equitylab",
    "productName": "PLO5 Equity Lab",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "main/**",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "../assets/plo5.ico",
      "extraResources": [
        {
          "from": "../plo5svc.exe",
          "to": "engine/plo5svc.exe"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.utilities",
      "extraResources": [
        {
          "from": "../plo5svc",
          "to": "engine/plo5svc"
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png",
      "category": "Utility",
      "extraResources": [
        {
          "from": "../plo5svc",
          "to": "engine/plo5svc"
        }
      ]
    }
  }
}
